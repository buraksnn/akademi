# npm run setup:env generates local-only random credentials and encryption keys.
DATABASE_URL=postgresql://akademi:CHANGE_ME@localhost:5432/akademi
POSTGRES_PASSWORD=CHANGE_ME
AUTH_SECRET=GENERATE_32_BYTES_HEX
APP_URL=http://localhost:3000
TCKN_ENCRYPTION_KEY=GENERATE_32_BYTES_HEX
TCKN_HMAC_KEY=GENERATE_32_BYTES_HEX
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Akademi <noreply@akademi.local>
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=akademi-private
S3_ACCESS_KEY=akademi-local
S3_SECRET_KEY=CHANGE_ME
MINIO_ROOT_USER=akademi-local
MINIO_ROOT_PASSWORD=CHANGE_ME
# Enable only behind a trusted reverse proxy that REPLACES x-forwarded-for.
TRUST_PROXY=false
